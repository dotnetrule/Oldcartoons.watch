# Build-time only. Neither key is read by the app at runtime — every network
# call happens in scripts/ or in CI, and the deployed site reads nothing but
# the JSON generated into public/data/.

# TMDB credentials, used by `npm run fetch`. Set either one — TMDB issues both
# for the same account and the v3 endpoints accept both. The read access token
# is preferred when both are present: it is sent as an Authorization header
# instead of a query parameter, so it never lands in a URL.
# Both are on https://www.themoviedb.org/settings/api
TMDB_READONLY_KEY=
TMDB_API_KEY=

# YouTube Data API v3 key, used by `npm run fetch` and `npm run health-check`.
# Get one at https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
