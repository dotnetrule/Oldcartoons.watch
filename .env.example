# Build-time only. Neither key is read by the app at runtime — every network
# call happens in scripts/ or in CI, and the deployed site reads nothing but
# the JSON generated into public/data/.

# TMDB API read token (recommended), used by `npm run enrich-tmdb` and `npm run fetch`.
# The shorter API v3 key remains supported as an alternative.
# Get one free at https://www.themoviedb.org/settings/api
#
# Without it both scripts say so and stop rather than failing: the episode
# lists in content/tmdb-episodes/ and the matches in content/tmdb-metadata.json
# are committed, so a clone with no credentials still builds the whole archive.
# It is needed to *refresh* or extend them, not to use them.
#
# This is also the only credential IMDb links need. There is no free IMDb API,
# and TMDB already holds the mapping.
TMDB_API_TOKEN=
# Alias accepted for dashboards that label the same bearer credential this way.
TMDB_READ_ONLY_KEY=
TMDB_API_KEY=

# YouTube Data API v3 key, used by `npm run fetch` and `npm run health-check`.
# Without it the public-page reader in scripts/lib/youtube-public.ts takes over.
# Get one at https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# How old a cached fetch may be before `npm run fetch` reads it again, in hours.
# Defaults to 24. `--max-age-hours N` overrides it per run and `--force` ignores
# the cache entirely. This exists so several pushes in one afternoon do not
# re-read every whitelisted playlist each time.
FETCH_MAX_AGE_HOURS=
