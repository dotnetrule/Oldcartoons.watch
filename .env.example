# Build-time only. Neither key is read by the app at runtime — every network
# call happens in scripts/ or in CI, and the deployed site reads nothing but
# the JSON generated into public/data/.

# TMDB API read token (recommended), used by `npm run enrich-tmdb` and `npm run fetch`.
# The shorter API v3 key remains supported as an alternative.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
# Alias accepted for dashboards that label the same bearer credential this way.
TMDB_READ_ONLY_KEY=
TMDB_API_KEY=

# YouTube Data API v3 key, used by `npm run fetch` and `npm run health-check`.
# Get one at https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
