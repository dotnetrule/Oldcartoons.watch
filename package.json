{
  "name": "tv-van-toen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build-data && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "add-playlist": "tsx scripts/add-playlist.ts",
    "resolve-playlists": "tsx scripts/resolve-playlists.ts",
    "fetch": "tsx scripts/fetch.ts",
    "match": "tsx scripts/match.ts",
    "scan-audio": "tsx scripts/scan-audio-tracks.ts",
    "build-data": "tsx scripts/build-data.ts",
    "health-check": "tsx scripts/health-check.ts"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
